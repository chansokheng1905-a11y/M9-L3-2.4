<!DOCTYPE html>
<html lang="km">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>កម្មវិធីអនុវត្តលំហាត់គណិតវិទ្យា ថ្នាក់ទី៩ - ការដាក់កន្សោមដឺក្រេទី២ជាផលគុណកត្តា</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;500;600;700&display=swap');

    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #eff6ff;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --radius-lg: 16px;
      --radius-md: 10px;
      --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Kantumruy Pro', system-ui, -apple-system, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #eef2ff 0%, #f0fdf4 100%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 24px 16px;
      line-height: 1.6;
    }

    .container {
      width: 100%;
      max-width: 820px;
    }

    .app-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .badge-topic {
      display: inline-block;
      background: #e0e7ff;
      color: #3730a3;
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .app-header h1 {
      font-size: 1.75rem;
      color: #1e1b4b;
      margin-bottom: 6px;
    }

    .app-header p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      padding: 30px 24px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .screen {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .screen.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .form-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 18px;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 10px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width: 600px) {
      .grid-2 { grid-template-columns: 1fr; }
      .card { padding: 20px 16px; }
      .app-header h1 { font-size: 1.4rem; }
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 0.9rem;
      font-weight: 600;
      color: #334155;
      margin-bottom: 6px;
    }

    .req { color: var(--danger); }

    .input-control {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      font-size: 0.95rem;
      background: #f8fafc;
      color: var(--text-main);
      transition: all 0.2s;
    }

    .input-control:focus {
      outline: none;
      border-color: var(--primary);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .info-box {
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 12px 16px;
      border-radius: 6px;
      margin-bottom: 20px;
      font-size: 0.9rem;
      color: #1e40af;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 22px;
      border-radius: var(--radius-md);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
      text-decoration: none;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }
    .btn-primary:hover { background: var(--primary-hover); }

    .btn-success {
      background: var(--success);
      color: #fff;
    }
    .btn-success:hover { background: #059669; }

    .btn-outline {
      background: #fff;
      color: #334155;
      border: 1.5px solid var(--border);
    }
    .btn-outline:hover:not(:disabled) {
      background: #f1f5f9;
    }
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .btn-block { width: 100%; }

    /* Screen 2: Quiz */
    .quiz-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }

    .quiz-progress-text {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--primary);
    }

    .student-badge-bar {
      font-size: 0.85rem;
      color: var(--text-muted);
      background: #f1f5f9;
      padding: 4px 12px;
      border-radius: 20px;
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 22px;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #3b82f6, #10b981);
      width: 10%;
      transition: width 0.3s;
    }

    .quiz-alert {
      display: none;
      background: #fef2f2;
      border: 1px solid #fca5a5;
      color: #dc2626;
      padding: 10px 14px;
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      margin-bottom: 16px;
    }

    .question-box {
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: var(--radius-md);
      padding: 20px;
      text-align: center;
      margin-bottom: 22px;
    }

    .question-instruction {
      font-size: 0.9rem;
      color: #64748b;
      margin-bottom: 8px;
    }

    .expression-display {
      font-size: 1.6rem;
      font-weight: 700;
      color: #0f172a;
    }

    .options-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 24px;
    }

    .option-card {
      display: flex;
      align-items: center;
      padding: 14px 18px;
      border: 1.8px solid var(--border);
      border-radius: var(--radius-md);
      cursor: pointer;
      background: #fff;
      transition: all 0.2s;
    }

    .option-card:hover {
      border-color: var(--primary);
      background: #f8faff;
    }

    .option-card.selected {
      border-color: var(--primary);
      background: var(--primary-light);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
    }

    .option-radio {
      width: 20px;
      height: 20px;
      border: 2px solid #94a3b8;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-right: 12px;
      flex-shrink: 0;
    }

    .option-card.selected .option-radio {
      border-color: var(--primary);
      background: var(--primary);
    }

    .option-card.selected .option-radio::after {
      content: "";
      width: 8px;
      height: 8px;
      background: #fff;
      border-radius: 50%;
    }

    .option-label {
      font-weight: 700;
      color: #475569;
      margin-right: 10px;
    }

    .option-card.selected .option-label { color: var(--primary); }

    .option-text {
      font-size: 1.05rem;
      color: #1e293b;
      flex: 1;
    }

    .nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }

    /* Screen 3: Results */
    .result-hero {
      text-align: center;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 20px;
    }

    .result-trophy { font-size: 3.2rem; margin-bottom: 6px; }
    .result-title { font-size: 1.5rem; font-weight: 700; }
    .result-subtitle { color: var(--text-muted); font-size: 0.95rem; }

    .student-summary-card {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 14px 18px;
      margin-bottom: 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px;
    }

    .summary-field-title { font-size: 0.8rem; color: var(--text-muted); }
    .summary-field-val { font-size: 0.95rem; font-weight: 600; color: #1e293b; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }

    @media (max-width: 600px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat-card {
      padding: 14px;
      border-radius: var(--radius-md);
      text-align: center;
      border: 1px solid var(--border);
    }

    .stat-score { background: #eff6ff; }
    .stat-pct { background: #fdf4ff; }
    .stat-correct { background: #ecfdf5; }
    .stat-wrong { background: #fef2f2; }

    .stat-number { font-size: 1.7rem; font-weight: 700; margin-bottom: 2px; }
    .stat-score .stat-number { color: #2563eb; }
    .stat-pct .stat-number { color: #a855f7; }
    .stat-correct .stat-number { color: #10b981; }
    .stat-wrong .stat-number { color: #ef4444; }
    .stat-label { font-size: 0.85rem; font-weight: 600; color: #64748b; }

    .table-container {
      width: 100%;
      overflow-x: auto;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      margin-bottom: 22px;
    }

    .review-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      background: #fff;
    }

    .review-table th {
      background: #f8fafc;
      padding: 10px 12px;
      font-weight: 600;
      color: #475569;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }

    .review-table td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
    }

    .badge-status {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .badge-correct { background: #ecfdf5; color: #065f46; }
    .badge-wrong { background: #fef2f2; color: #991b1b; }

    .btn-solution {
      background: none;
      border: none;
      color: var(--primary);
      font-size: 0.8rem;
      cursor: pointer;
      text-decoration: underline;
      display: block;
      margin-top: 4px;
    }

    .solution-box {
      display: none;
      margin-top: 6px;
      padding: 8px 10px;
      background: #f1f5f9;
      border-left: 3px solid #6366f1;
      border-radius: 4px;
      font-size: 0.85rem;
      color: #334155;
    }

    .solution-box.show { display: block; }

    .action-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    @media print {
      body { background: #fff; padding: 0; }
      .card { box-shadow: none; border: none; }
      .action-buttons, .btn-solution { display: none !important; }
      .solution-box { display: block !important; }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Header -->
    <div class="app-header">
      <span class="badge-topic">គណិតវិទ្យាថ្នាក់ទី៩ • មេរៀន កន្សោមពិជគណិត</span>
      <h1>ការដាក់កន្សោមជាផលគុណកត្តា (ដឺក្រេទី២)</h1>
      <p>២.៤ ការដាក់កន្សោមជាផលគុណកត្តាតាមរយៈការបំពេញ និងបន្ថែមបន្ថយតួ</p>
    </div>

    <!-- SCREEN 1: Student Information -->
    <div id="screen-student-info" class="screen active card">
      <h2 class="form-title">👨‍🎓 ព័ត៌មានសិស្ស</h2>

      <div class="info-box">
        💡 <strong>ការណែនាំ៖</strong> សូមបំពេញព័ត៌មានផ្ទាល់ខ្លួនខាងក្រោមឱ្យបានត្រឹមត្រូវ រួចចុចប៊ូតុង <strong>«ចាប់ផ្តើមធ្វើលំហាត់»</strong> (លំហាត់កម្រិតដឺក្រេទី២ មានចំនួន ១០ សំណួរ)។
      </div>

      <form id="student-form" onsubmit="event.preventDefault(); startQuiz();">
        <div class="grid-2">
          <div class="form-group">
            <label for="student-name">ឈ្មោះពេញសិស្ស <span class="req">*</span></label>
            <input type="text" id="student-name" class="input-control" placeholder="ឧ. សុខ ចាន់ដារ៉ា" required />
          </div>

          <div class="form-group">
            <label for="student-gender">ភេទ <span class="req">*</span></label>
            <select id="student-gender" class="input-control" required>
              <option value="">-- ជ្រើសរើសភេទ --</option>
              <option value="ប្រុស">ប្រុស</option>
              <option value="ស្រី">ស្រី</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="student-class">ថ្នាក់ / បន្ទប់រៀន <span class="req">*</span></label>
            <input type="text" id="student-class" class="input-control" placeholder="ឧ. ៩ក ឬ 9A" required />
          </div>

          <div class="form-group">
            <label for="student-id">លេខសម្គាល់សិស្ស (បើមាន)</label>
            <input type="text" id="student-id" class="input-control" placeholder="ឧ. STU-0091" />
          </div>
        </div>

        <div class="form-group">
          <label for="quiz-date">កាលបរិច្ឆេទ</label>
          <input type="date" id="quiz-date" class="input-control" />
        </div>

        <div style="margin-top: 20px;">
          <button type="submit" class="btn btn-primary btn-block" style="padding: 13px; font-size: 1.05rem;">
            🚀 ចាប់ផ្តើមធ្វើលំហាត់
          </button>
        </div>
      </form>
    </div>

    <!-- SCREEN 2: Quiz (10 Questions - Degree 2) -->
    <div id="screen-quiz" class="screen card">
      <div class="quiz-meta">
        <div class="quiz-progress-text" id="quiz-progress-label">📝 លំហាត់ ១ / ១០</div>
        <div class="student-badge-bar" id="quiz-student-tag"></div>
      </div>

      <!-- Progress Bar -->
      <div class="progress-track">
        <div class="progress-fill" id="progress-bar-fill"></div>
      </div>

      <!-- Validation Alert -->
      <div id="quiz-alert" class="quiz-alert">
        ⚠️ សូមជ្រើសរើសចម្លើយមួយ (A, B, C ឬ D) ជាមុនសិន មុននឹងបន្តទៅមុខ!
      </div>

      <!-- Expression Display -->
      <div class="question-box">
        <div class="question-instruction">ចូរដាក់កន្សោមដឺក្រេទី២ខាងក្រោមជាផលគុណកត្តា៖</div>
        <div class="expression-display" id="question-expression"></div>
      </div>

      <!-- Choices A, B, C, D -->
      <div class="options-grid" id="options-container"></div>

      <!-- Navigation -->
      <div class="nav-bar">
        <button id="btn-prev" class="btn btn-outline" onclick="prevQuestion()" disabled>
          ← មុន
        </button>

        <button id="btn-next" class="btn btn-primary" onclick="nextQuestion()">
          បន្ទាប់ →
        </button>

        <button id="btn-finish" class="btn btn-success" onclick="finishQuiz()" style="display: none;">
          ✨ បញ្ចប់ការធ្វើលំហាត់
        </button>
      </div>
    </div>

    <!-- SCREEN 3: Result -->
    <div id="screen-result" class="screen card">
      <div class="result-hero">
        <div class="result-trophy" id="result-emoji">🎉</div>
        <h2 class="result-title" id="result-greeting">លទ្ធផលនៃការធ្វើលំហាត់</h2>
        <p class="result-subtitle" id="result-feedback">ការខិតខំប្រឹងប្រែងរបស់អ្នកទទួលបានលទ្ធផលល្អ!</p>
      </div>

      <div class="student-summary-card">
        <div>
          <div class="summary-field-title">ឈ្មោះសិស្ស</div>
          <div class="summary-field-val" id="res-name">-</div>
        </div>
        <div>
          <div class="summary-field-title">ភេទ</div>
          <div class="summary-field-val" id="res-gender">-</div>
        </div>
        <div>
          <div class="summary-field-title">ថ្នាក់</div>
          <div class="summary-field-val" id="res-class">-</div>
        </div>
        <div>
          <div class="summary-field-title">លេខសម្គាល់ / កាលបរិច្ឆេទ</div>
          <div class="summary-field-val" id="res-id-date">-</div>
        </div>
      </div>

      <!-- Scores -->
      <div class="stats-grid">
        <div class="stat-card stat-score">
          <div class="stat-number" id="res-score">0 / 10</div>
          <div class="stat-label">ពិន្ទុសរុប</div>
        </div>
        <div class="stat-card stat-pct">
          <div class="stat-number" id="res-pct">0%</div>
          <div class="stat-label">ភាគរយ</div>
        </div>
        <div class="stat-card stat-correct">
          <div class="stat-number" id="res-correct">0</div>
          <div class="stat-label">🟢 ត្រឹមត្រូវ</div>
        </div>
        <div class="stat-card stat-wrong">
          <div class="stat-number" id="res-wrong">0</div>
          <div class="stat-label">🔴 មិនត្រឹមត្រូវ</div>
        </div>
      </div>

      <!-- Summary Table -->
      <div style="font-weight: 700; margin-bottom: 12px; color: #1e293b;">
        📊 តារាងសង្ខេបចម្លើយទាំង ១០ លំហាត់
      </div>

      <div class="table-container">
        <table class="review-table">
          <thead>
            <tr>
              <th style="width: 8%;">ល.រ</th>
              <th style="width: 28%;">កន្សោមលំហាត់</th>
              <th style="width: 25%;">ចម្លើយសិស្ស</th>
              <th style="width: 25%;">ចម្លើយត្រឹមត្រូវ</th>
              <th style="width: 14%;">ស្ថានភាព</th>
            </tr>
          </thead>
          <tbody id="review-table-body"></tbody>
        </table>
      </div>

      <div class="action-buttons">
        <button class="btn btn-outline" onclick="restartQuiz()">
          🔄 ធ្វើម្តងទៀត
        </button>
        <button class="btn btn-primary" onclick="downloadCSV()">
          ⬇️ ទាញយកទិន្នន័យ (CSV)
        </button>
        <button class="btn btn-success" onclick="window.print()">
          🖨️ បោះពុម្ព / រក្សាទុក PDF
        </button>
      </div>
    </div>
  </div>

  <script>
    // 10 Grade 9 Math Exercises (Degree 2 - Factoring by Completing Square & Adding/Subtracting Terms)
    const questions = [
      {
        id: 1,
        expression: "A = x² + 4x - 5",
        options: [
          { key: "A", text: "(x - 1)(x + 5)" },
          { key: "B", text: "(x + 1)(x - 5)" },
          { key: "C", text: "(x - 2)(x + 3)" },
          { key: "D", text: "(x + 2)(x - 3)" }
        ],
        correct: "A",
        solution: "x² + 4x - 5 = (x² + 4x + 4) - 4 - 5 = (x + 2)² - 9 = (x + 2)² - 3² = (x + 2 - 3)(x + 2 + 3) = (x - 1)(x + 5)"
      },
      {
        id: 2,
        expression: "B = x² - 6x + 8",
        options: [
          { key: "A", text: "(x + 4)(x + 2)" },
          { key: "B", text: "(x - 4)(x - 2)" },
          { key: "C", text: "(x - 1)(x - 8)" },
          { key: "D", text: "(x + 1)(x - 8)" }
        ],
        correct: "B",
        solution: "x² - 6x + 8 = (x² - 6x + 9) - 9 + 8 = (x - 3)² - 1 = (x - 3 - 1)(x - 3 + 1) = (x - 4)(x - 2)"
      },
      {
        id: 3,
        expression: "C = x² + 6x + 5",
        options: [
          { key: "A", text: "(x - 1)(x - 5)" },
          { key: "B", text: "(x + 2)(x + 3)" },
          { key: "C", text: "(x + 1)(x + 5)" },
          { key: "D", text: "(x - 2)(x - 3)" }
        ],
        correct: "C",
        solution: "x² + 6x + 5 = (x² + 6x + 9) - 9 + 5 = (x + 3)² - 4 = (x + 3)² - 2² = (x + 3 - 2)(x + 3 + 2) = (x + 1)(x + 5)"
      },
      {
        id: 4,
        expression: "D = x² - 4x - 5",
        options: [
          { key: "A", text: "(x - 5)(x + 1)" },
          { key: "B", text: "(x + 5)(x - 1)" },
          { key: "C", text: "(x - 2)(x + 5)" },
          { key: "D", text: "(x - 1)(x - 5)" }
        ],
        correct: "A",
        solution: "x² - 4x - 5 = (x² - 4x + 4) - 4 - 5 = (x - 2)² - 9 = (x - 2)² - 3² = (x - 2 - 3)(x - 2 + 3) = (x - 5)(x + 1)"
      },
      {
        id: 5,
        expression: "E = x² + 8x + 12",
        options: [
          { key: "A", text: "(x - 2)(x - 6)" },
          { key: "B", text: "(x + 3)(x + 4)" },
          { key: "C", text: "(x - 3)(x - 4)" },
          { key: "D", text: "(x + 2)(x + 6)" }
        ],
        correct: "D",
        solution: "x² + 8x + 12 = (x² + 8x + 16) - 16 + 12 = (x + 4)² - 4 = (x + 4)² - 2² = (x + 4 - 2)(x + 4 + 2) = (x + 2)(x + 6)"
      },
      {
        id: 6,
        expression: "F = x² - 2x - 8",
        options: [
          { key: "A", text: "(x - 4)(x + 2)" },
          { key: "B", text: "(x + 4)(x - 2)" },
          { key: "C", text: "(x - 1)(x + 8)" },
          { key: "D", text: "(x + 1)(x - 8)" }
        ],
        correct: "A",
        solution: "x² - 2x - 8 = (x² - 2x + 1) - 1 - 8 = (x - 1)² - 9 = (x - 1)² - 3² = (x - 1 - 3)(x - 1 + 3) = (x - 4)(x + 2)"
      },
      {
        id: 7,
        expression: "G = x² + 10x + 21",
        options: [
          { key: "A", text: "(x - 3)(x - 7)" },
          { key: "B", text: "(x + 3)(x + 7)" },
          { key: "C", text: "(x + 1)(x + 21)" },
          { key: "D", text: "(x - 1)(x - 21)" }
        ],
        correct: "B",
        solution: "x² + 10x + 21 = (x² + 10x + 25) - 25 + 21 = (x + 5)² - 4 = (x + 5)² - 2² = (x + 5 - 2)(x + 5 + 2) = (x + 3)(x + 7)"
      },
      {
        id: 8,
        expression: "H = x² - 8x + 7",
        options: [
          { key: "A", text: "(x + 7)(x + 1)" },
          { key: "B", text: "(x - 7)(x + 1)" },
          { key: "C", text: "(x - 7)(x - 1)" },
          { key: "D", text: "(x - 4)(x - 3)" }
        ],
        correct: "C",
        solution: "x² - 8x + 7 = (x² - 8x + 16) - 16 + 7 = (x - 4)² - 9 = (x - 4)² - 3² = (x - 4 - 3)(x - 4 + 3) = (x - 7)(x - 1)"
      },
      {
        id: 9,
        expression: "I = x² - 2x - 15",
        options: [
          { key: "A", text: "(x - 5)(x + 3)" },
          { key: "B", text: "(x + 5)(x - 3)" },
          { key: "C", text: "(x - 1)(x + 15)" },
          { key: "D", text: "(x - 15)(x + 1)" }
        ],
        correct: "A",
        solution: "x² - 2x - 15 = (x² - 2x + 1) - 1 - 15 = (x - 1)² - 16 = (x - 1)² - 4² = (x - 1 - 4)(x - 1 + 4) = (x - 5)(x + 3)"
      },
      {
        id: 10,
        expression: "J = x² + 4x - 12",
        options: [
          { key: "A", text: "(x + 2)(x - 6)" },
          { key: "B", text: "(x - 3)(x + 4)" },
          { key: "C", text: "(x - 2)(x + 6)" },
          { key: "D", text: "(x + 3)(x - 4)" }
        ],
        correct: "C",
        solution: "x² + 4x - 12 = (x² + 4x + 4) - 4 - 12 = (x + 2)² - 16 = (x + 2)² - 4² = (x + 2 - 4)(x + 2 + 4) = (x - 2)(x + 6)"
      }
    ];

    let studentData = { name: "", gender: "", class: "", id: "", date: "" };
    let currentIndex = 0;
    let studentAnswers = new Array(questions.length).fill(null);

    window.addEventListener("DOMContentLoaded", () => {
      document.getElementById("quiz-date").value = new Date().toISOString().split("T")[0];
    });

    function toKhmerNum(num) {
      const khmerDigits = ["០", "១", "២", "៣", "៤", "៥", "៦", "៧", "៨", "៩"];
      return num.toString().split("").map(ch => khmerDigits[ch] || ch).join("");
    }

    function showScreen(screenId) {
      document.querySelectorAll(".screen").forEach(el => el.classList.remove("active"));
      document.getElementById(screenId).classList.add("active");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function startQuiz() {
      const name = document.getElementById("student-name").value.trim();
      const gender = document.getElementById("student-gender").value;
      const studentClass = document.getElementById("student-class").value.trim();
      const id = document.getElementById("student-id").value.trim();
      const date = document.getElementById("quiz-date").value;

      if (!name || !gender || !studentClass) {
        alert("សូមបំពេញឈ្មោះ ភេទ និងថ្នាក់ឱ្យបានគ្រប់គ្រាន់!");
        return;
      }

      studentData = {
        name,
        gender,
        class: studentClass,
        id: id || "គ្មាន",
        date: date || new Date().toISOString().split("T")[0]
      };

      currentIndex = 0;
      studentAnswers = new Array(questions.length).fill(null);

      document.getElementById("quiz-student-tag").textContent = `សិស្ស៖ ${studentData.name} (${studentData.class})`;
      renderQuestion();
      showScreen("screen-quiz");
    }

    function renderQuestion() {
      const q = questions[currentIndex];
      document.getElementById("quiz-alert").style.display = "none";

      document.getElementById("quiz-progress-label").textContent = `📝 លំហាត់ ${toKhmerNum(currentIndex + 1)} / ${toKhmerNum(questions.length)}`;
      document.getElementById("progress-bar-fill").style.width = (((currentIndex + 1) / questions.length) * 100) + "%";

      document.getElementById("question-expression").textContent = q.expression;

      const container = document.getElementById("options-container");
      container.innerHTML = "";

      const currentSelected = studentAnswers[currentIndex];

      q.options.forEach(opt => {
        const isSelected = currentSelected === opt.key;
        const card = document.createElement("div");
        card.className = "option-card" + (isSelected ? " selected" : "");
        card.onclick = () => selectOption(opt.key);

        card.innerHTML = `
          <div class="option-radio"></div>
          <div class="option-label">${opt.key}.</div>
          <div class="option-text">${opt.text}</div>
        `;
        container.appendChild(card);
      });

      document.getElementById("btn-prev").disabled = currentIndex === 0;

      if (currentIndex === questions.length - 1) {
        document.getElementById("btn-next").style.display = "none";
        document.getElementById("btn-finish").style.display = "inline-flex";
      } else {
        document.getElementById("btn-next").style.display = "inline-flex";
        document.getElementById("btn-finish").style.display = "none";
      }
    }

    function selectOption(key) {
      studentAnswers[currentIndex] = key;
      document.getElementById("quiz-alert").style.display = "none";
      renderQuestion();
    }

    function prevQuestion() {
      if (currentIndex > 0) {
        currentIndex--;
        renderQuestion();
      }
    }

    function nextQuestion() {
      if (!studentAnswers[currentIndex]) {
        document.getElementById("quiz-alert").style.display = "block";
        return;
      }
      if (currentIndex < questions.length - 1) {
        currentIndex++;
        renderQuestion();
      }
    }

    function finishQuiz() {
      if (!studentAnswers[currentIndex]) {
        document.getElementById("quiz-alert").style.display = "block";
        return;
      }

      let correctCount = 0;
      questions.forEach((q, idx) => {
        if (studentAnswers[idx] === q.correct) correctCount++;
      });

      const wrongCount = questions.length - correctCount;
      const pct = Math.round((correctCount / questions.length) * 100);

      document.getElementById("res-name").textContent = studentData.name;
      document.getElementById("res-gender").textContent = studentData.gender;
      document.getElementById("res-class").textContent = studentData.class;
      document.getElementById("res-id-date").textContent = `${studentData.id} • ${studentData.date}`;

      document.getElementById("res-score").textContent = `${toKhmerNum(correctCount)} / ${toKhmerNum(questions.length)}`;
      document.getElementById("res-pct").textContent = `${toKhmerNum(pct)}%`;
      document.getElementById("res-correct").textContent = toKhmerNum(correctCount);
      document.getElementById("res-wrong").textContent = toKhmerNum(wrongCount);

      const emojiEl = document.getElementById("result-emoji");
      const titleEl = document.getElementById("result-greeting");
      const feedbackEl = document.getElementById("result-feedback");

      if (correctCount === 10) {
        emojiEl.textContent = "🏆";
        titleEl.textContent = "ពូកែឥតខ្ចោះ! ទទួលបានពិន្ទុពេញ";
        feedbackEl.textContent = "អ្នកបានយល់ច្បាស់ពីការដាក់កន្សោមដឺក្រេទី២ជាផលគុណកត្តាតាមវិធីបំពេញជាការេ និងបន្ថែមបន្ថយតួ!";
      } else if (correctCount >= 8) {
        emojiEl.textContent = "🌟";
        titleEl.textContent = "លទ្ធផលល្អប្រសើរណាស់!";
        feedbackEl.textContent = "អ្នកធ្វើបានល្អណាស់! សូមបន្តខិតខំប្រឹងប្រែងបន្ថែមទៀត។";
      } else if (correctCount >= 5) {
        emojiEl.textContent = "👍";
        titleEl.textContent = "លទ្ធផលល្អបង្គួរ!";
        feedbackEl.textContent = "អ្នកបានយល់ដឹងច្រើន ប៉ុន្តែនៅមានចំណុចខ្លះត្រូវពិនិត្យឡើងវិញបន្ថែម។";
      } else {
        emojiEl.textContent = "💪";
        titleEl.textContent = "កុំទាន់អស់សង្ឃឹម ត្រូវខិតខំបន្ថែមទៀត!";
        feedbackEl.textContent = "សូមពិនិត្យមើលដំណោះស្រាយលម្អិតខាងក្រោម ហើយសាកល្បងធ្វើម្តងទៀត។";
      }

      const tbody = document.getElementById("review-table-body");
      tbody.innerHTML = "";

      questions.forEach((q, idx) => {
        const userChoice = studentAnswers[idx];
        const isCorrect = userChoice === q.correct;
        const userOpt = q.options.find(o => o.key === userChoice);
        const correctOpt = q.options.find(o => o.key === q.correct);

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td><strong>${toKhmerNum(idx + 1)}</strong></td>
          <td>
            <strong>${q.expression}</strong>
            <button class="btn-solution" onclick="toggleSolution(${idx})">🔍 មើលដំណោះស្រាយ</button>
            <div id="sol-${idx}" class="solution-box">
              <strong>វិធីបំពេញជាការេ និងបន្ថែមបន្ថយតួ៖</strong><br/>
              ${q.solution}
            </div>
          </td>
          <td style="color: ${isCorrect ? '#10b981' : '#ef4444'}; font-weight: 500;">
            (${userOpt ? userOpt.key : '-'}) ${userOpt ? userOpt.text : 'មិនបានឆ្លើយ'}
          </td>
          <td style="color: #10b981; font-weight: 600;">
            (${correctOpt.key}) ${correctOpt.text}
          </td>
          <td>
            <span class="badge-status ${isCorrect ? 'badge-correct' : 'badge-wrong'}">
              ${isCorrect ? '🟢 ត្រឹមត្រូវ' : '🔴 មិនត្រឹមត្រូវ'}
            </span>
          </td>
        `;
        tbody.appendChild(tr);
      });

      showScreen("screen-result");
    }

    function toggleSolution(idx) {
      const box = document.getElementById(`sol-${idx}`);
      if (box) box.classList.toggle("show");
    }

    function restartQuiz() {
      if (confirm("តើអ្នកពិតជាចង់ធ្វើលំហាត់ម្តងទៀតមែនទេ?")) {
        currentIndex = 0;
        studentAnswers = new Array(questions.length).fill(null);
        showScreen("screen-student-info");
      }
    }

    function downloadCSV() {
      let correctCount = 0;
      questions.forEach((q, idx) => {
        if (studentAnswers[idx] === q.correct) correctCount++;
      });
      const pct = Math.round((correctCount / questions.length) * 100);

      let csv = "\uFEFF"; // UTF-8 BOM សម្រាប់ភាសាខ្មែរក្នុង Excel
      csv += "របាយការណ៍លទ្ធផលលំហាត់គណិតវិទ្យាថ្នាក់ទី៩ - ការដាក់កន្សោមដឺក្រេទី២ជាផលគុណកត្តា\n";
      csv += `ឈ្មោះសិស្ស,${studentData.name}\n`;
      csv += `ភេទ,${studentData.gender}\n`;
      csv += `ថ្នាក់,${studentData.class}\n`;
      csv += `លេខសម្គាល់សិស្ស,${studentData.id}\n`;
      csv += `កាលបរិច្ឆេទ,${studentData.date}\n`;
      csv += `ពិន្ទុ,${correctCount} / ${questions.length}\n`;
      csv += `ភាគរយ,${pct}%\n\n`;

      csv += "ល.រ,កន្សោមលំហាត់,ចម្លើយសិស្ស,ចម្លើយត្រឹមត្រូវ,ស្ថានភាព\n";

      questions.forEach((q, idx) => {
        const userChoice = studentAnswers[idx];
        const isCorrect = userChoice === q.correct;
        const userOpt = q.options.find(o => o.key === userChoice);
        const correctOpt = q.options.find(o => o.key === q.correct);

        const uText = userOpt ? `"${userOpt.key}. ${userOpt.text}"` : '"មិនបានឆ្លើយ"';
        const cText = `"${correctOpt.key}. ${correctOpt.text}"`;
        const status = isCorrect ? "ត្រឹមត្រូវ" : "មិនត្រឹមត្រូវ";

        csv += `${idx + 1},"${q.expression}",${uText},${cText},${status}\n`;
      });

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `លទ្ធផល_${studentData.name.replace(/\s+/g, '_')}_ដឺក្រេទី២.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>
</body>
</html>
